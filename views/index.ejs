}

/* =========================================================
   EVENTOS DE PREGUNTAS Y CIERRE DE FASES
   ========================================================= */

function wireQuestionEvents(phase){
  // Botones verificar/pista
  const buttons = elPhaseContent.querySelectorAll("button[data-action]");
  buttons.forEach(btn => {
    btn.addEventListener("click", () => {
      const qid = btn.getAttribute("data-qid");
      const action = btn.getAttribute("data-action");
      const qu = phase.questions.find(x => x.id === qid);
      if(!qu) return;

      if(action === "hint"){
        toast(qu.fbTip);
        return;
      }

      if(action === "check"){
        checkQuestion(phase, qu);
      }
    });
  });
}

function checkQuestion(phase, qu){
  const radios = elPhaseContent.querySelectorAll(`input[name="${qu.id}"]`);
  let choice = null;
  radios.forEach(r => { if(r.checked) choice = Number(r.value); });

  if(choice === null){
    toast("Selecciona una opción antes de verificar.");
    return;
  }

  let ans = state.answers[qu.id] || { choice: null, attempts: 0, awarded: 0 };
  let attempts = Number(ans.attempts||0);

  if(attempts >= 2){
    toast("Ya utilizaste tus 2 intentos. Revisa retroalimentación y continúa.");
    return;
  }

  attempts += 1;
  ans.choice = choice;
  ans.attempts = attempts;

  const isRight = (choice === qu.correctIndex);

  // Puntaje: si acierta en intento 1 => 1.0, en intento 2 => 0.5; si ya tenía puntaje, no cambiarlo.
  if(isRight && !ans.awarded){
    ans.awarded = (attempts === 1) ? 1 : 0.5;
  } else if(!isRight && !ans.awarded){
    ans.awarded = 0;
  }

  state.answers[qu.id] = ans;
  saveState();

  // actualizar UI: feedback, intentos, badges
  const fbDiv = document.getElementById(`fb_${qu.id}`);
  fbDiv.innerHTML = buildFeedbackHtml(qu, ans);

  const attSpan = document.getElementById(`att_${qu.id}`);
  if(attSpan) attSpan.textContent = attempts;

  // Re-render tarjeta para badge (simple: ajustar badge en cabecera)
  const card = document.getElementById(`card_${qu.id}`);
  if(card){
    const badgeContainer = card.querySelector(".qhead .inline");
    if(badgeContainer){
      let badge = "";
      if(ans.awarded === 1) badge = `<span class="badge ok">+1</span>`;
      else if(ans.awarded === 0.5) badge = `<span class="badge ok">+0.5</span>`;
      else badge = `<span class="badge warn">revisable</span>`;
      badgeContainer.innerHTML = badge;
    }
  }

  // actualizar KPI / cierre fase
  renderNav();
  updateTopPills();

  // Si todas respondidas, habilitar finalizar
  const finishBtn = document.getElementById("btnFinishPhase");
  if(finishBtn){
    const okAttempted = allQuestionsAttempted(phase.id);
    finishBtn.disabled = !okAttempted;
    finishBtn.style.opacity = okAttempted ? "1" : ".6";
    finishBtn.style.cursor = okAttempted ? "pointer" : "not-allowed";
  }

  // Mensaje motivador corto
  if(isRight){
    toast("¡Muy bien! Esa interpretación ambiental es sólida.");
  } else {
    toast("Buen intento. Revisa la lectura y ajusta tu enfoque ambiental.");
  }
}

function wireFinishBoxEvents(phase){
  const btnFinish = document.getElementById("btnFinishPhase");
  if(btnFinish){
    btnFinish.addEventListener("click", () => {
      if(!allQuestionsAttempted(phase.id)){
        toast("Aún faltan preguntas por responder.");
        return;
      }
      state.phaseFinished[phase.id] = true;
      saveState();
      toast(`Fase ${phase.id} finalizada. Ahora puedes solicitar la clave para avanzar.`);
      goToPhase(phase.id);
    });
  }

  const btnUnlock = document.getElementById("btnUnlockNext");
  if(btnUnlock){
    btnUnlock.addEventListener("click", () => {
      const input = document.getElementById("teacherKeyInput");
      const typed = (input.value||"").trim();

      const expected = (TEACHER_KEYS[phase.id]||"").trim();
      if(!expected){
        toast("No hay clave definida para esta fase en TEACHER_KEYS.");
        return;
      }
      if(typed === expected){
        state.phaseUnlocks[phase.id] = true;
        saveState();
        toast(`Fase ${phase.id+1} desbloqueada.`);
        goToPhase(phase.id); // refrescar caja
      } else {
        toast("Clave no coincide. Pide al docente que la confirme.");
      }
    });
  }

  const btnCopy = document.getElementById("btnCopyCode");
  if(btnCopy){
    btnCopy.addEventListener("click", async () => {
      const box = document.getElementById("resultCodeBox");
      const text = box ? box.textContent : "";
      try{
        await navigator.clipboard.writeText(text);
        toast("Código copiado al portapapeles.");
      } catch(e){
        toast("No se pudo copiar automáticamente. Selecciona el código y cópialo manualmente.");
      }
    });
  }

  const btnRecalc = document.getElementById("btnRecalcCode");
  if(btnRecalc){
    btnRecalc.addEventListener("click", () => {
      goToPhase(6);
      toast("Código recalculado según tus respuestas actuales.");
    });
  }
}

