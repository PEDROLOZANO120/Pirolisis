function renderQuestions(phase){
  return phase.questions.map((qu, idx) => {
    const a = state.answers[qu.id] || { choice: null, attempts: 0, awarded: 0 };
    const attempts = Number(a.attempts||0);
    const awarded = a.awarded || 0;

    const statusBadge = awarded === 1
      ? `<span class="badge ok">+1</span>`
      : awarded === 0.5
        ? `<span class="badge ok">+0.5</span>`
        : attempts > 0
          ? `<span class="badge warn">revisable</span>`
          : `<span class="badge">sin responder</span>`;

    const optionsHtml = qu.options.map((opt, i) => {
      const checked = (a.choice === i) ? "checked" : "";
      return `
        <label class="opt">
          <input type="radio" name="${qu.id}" value="${i}" ${checked} />
          <div>
            <div style="font-weight:650">${escapeHtml(opt)}</div>
          </div>
        </label>
      `;
    }).join("");

    const fb = buildFeedbackHtml(qu, a);

    return `
      <div class="qcard" id="card_${qu.id}">
        <div class="qhead">
          <div>
            <h3>${idx+1}. ${escapeHtml(qu.prompt)}</h3>
            <div class="qmeta">Intentos usados: <strong id="att_${qu.id}">${attempts}</strong> / 2</div>
          </div>
          <div class="inline">
            ${statusBadge}
          </div>
        </div>

        <div class="options">
          ${optionsHtml}
        </div>

        <div class="qactions">
          <button class="btn primary" data-action="check" data-qid="${qu.id}">Verificar</button>
          <button class="btn" data-action="hint" data-qid="${qu.id}">Pista</button>
          <span class="small muted">Consejo: elige la opción que mejor sostenga una interpretación ambiental.</span>
        </div>

        <div id="fb_${qu.id}">
          ${fb}
        </div>
      </div>
    `;
  }).join("");
}

function buildFeedbackHtml(qu, ans){
  const attempts = Number(ans.attempts||0);
  const awarded = ans.awarded || 0;

  if(attempts === 0) return `<div class="feedback tip">Cuando respondas, recibirás retroalimentación inmediata para fortalecer tu análisis ambiental.</div>`;

  // Intento 1 o 2: mostrar mensaje según estado.
  if(awarded === 1){
    return `<div class="feedback ok"><strong>¡Buen análisis!</strong> ${escapeHtml(qu.fbOk)}</div>`;
  }
  if(awarded === 0.5){
    return `<div class="feedback ok"><strong>¡Buen ajuste conceptual!</strong> ${escapeHtml(qu.fbOk)} <span class="muted">(Obtuviste 0.5 puntos por consolidar en el 2do intento.)</span></div>`;
  }
  // Aún no acertó
  if(attempts === 1){
    return `<div class="feedback tip"><strong>Vas bien encaminado.</strong> Revisa la lectura y ajusta tu elección. ${escapeHtml(qu.fbTip)} <span class="muted">Tienes un intento más.</span></div>`;
  }
  // intentos=2 y no acertó
  return `<div class="feedback tip"><strong>Gracias por el esfuerzo.</strong> Te recomiendo releer el apartado clave y conversar este punto en clase. ${escapeHtml(qu.fbTip)}</div>`;
}

function countPhaseAttempts(phaseId){
  const ph = PHASES.find(p => p.id === phaseId);
  let n = 0;
  for(const qu of ph.questions){
    const a = state.answers[qu.id];
    if(a) n += Number(a.attempts||0);
  }
  return n;
}

function allQuestionsAttempted(phaseId){
  const ph = PHASES.find(p => p.id === phaseId);
  return ph.questions.every(qu => (state.answers[qu.id] && Number(state.answers[qu.id].attempts||0) > 0));
}

function renderPhaseFinishBox(phase){
  const attempted = allQuestionsAttempted(phase.id);
  const {earned, max} = computePhasePoints(phase.id);

  const finishState = state.phaseFinished[phase.id] ? "finalizada" : "en progreso";
  const finishBadge = state.phaseFinished[phase.id] ? "ok" : "warn";

  let unlockHtml = "";
  const isLast = phase.id === 6;

  if(!state.phaseFinished[phase.id]){
    unlockHtml += `
      <div class="callout">
        <strong>Finalizar fase:</strong> responde todas las preguntas (al menos una vez) y pulsa “Finalizar”.
        <div class="small muted" style="margin-top:6px">
          Tu puntaje actual de la fase es <strong>${earned}/${max}</strong>. Si deseas subirlo, ajusta respuestas antes de finalizar.
        </div>
      </div>
      <div class="inline">
        <button class="btn primary" id="btnFinishPhase" ${attempted ? "" : "disabled"} style="${attempted ? "" : "opacity:.6; cursor:not-allowed"}">
          Finalizar Fase ${phase.id}
        </button>
        <span class="small muted">${attempted ? "Listo para finalizar." : "Aún faltan preguntas por responder."}</span>
      </div>
    `;
  } else {
    if(isLast){
      unlockHtml += renderFinalEvaluationBox();
    } else {
      unlockHtml += renderUnlockNextBox(phase.id);
    }
  }

  return `
    <h3 style="margin:0 0 8px; font-size:15px">Cierre y avance</h3>
    <div class="inline" style="margin-bottom:10px">
      <span class="badge ${finishBadge}">Estado: ${finishState}</span>
      <span class="badge">Puntaje fase: ${earned}/${max}</span>
      <span class="badge">Preguntas respondidas: ${attempted ? "sí" : "no"}</span>
    </div>
    ${unlockHtml}
  `;
}

function renderUnlockNextBox(phaseId){
  const nextId = phaseId + 1;
  const keyNeeded = TEACHER_KEYS[phaseId] || "(no definida)";

  const already = !!state.phaseUnlocks[phaseId];
  if(already){
    return `
      <div class="callout">
        <strong>¡Siguiente fase desbloqueada!</strong> Puedes continuar a la Fase ${nextId}.
      </div>
      <div class="inline">
        <button class="btn primary" onclick="goToPhase(${nextId})">Ir a Fase ${nextId}</button>
        <button class="btn" onclick="goToPhase(${phaseId})">Revisar esta fase</button>
      </div>
      <div class="small muted" style="margin-top:8px">
        Si deseas mejorar tu nota, puedes volver a revisar preguntas (el puntaje se recalcula).
      </div>
    `;
  }

  return `
    <div class="callout">
      <strong>Para avanzar a la Fase ${nextId}:</strong> solicita al docente la clave de desbloqueo.
      <div class="small muted" style="margin-top:6px">
        <span class="muted">Nota:</span> el docente puede cambiar estas claves en la variable <span class="mono">TEACHER_KEYS</span>.
      </div>
    </div>

    <label class="small"><strong>Clave del docente (para desbloquear Fase ${nextId})</strong></label>
    <input class="input" id="teacherKeyInput" placeholder="Ingresa la clave proporcionada por el docente" />

    <div class="inline" style="margin-top:10px">
      <button class="btn primary" id="btnUnlockNext">Desbloquear Fase ${nextId}</button>
      <button class="btn" onclick="goToPhase(${phaseId})">Quedarme aquí</button>
    </div>

    <div class="note" style="margin-top:12px">
      Sugerencia pedagógica: antes de pedir la clave, revisa tus respuestas y retroalimentación para fortalecer comprensión ambiental.
    </div>
  `;
}

function renderFinalEvaluationBox(){
  const {earned, max} = computeEarnedPoints();
  const grade10 = max ? round1((earned/max)*10) : 0;
  const code = buildResultCode();

  // Tabla por fases
  const rows = PHASES.map(ph => {
    const p = computePhasePoints(ph.id);
    return `<tr><td>Fase ${ph.id}</td><td>${escapeHtml(ph.short)}</td><td>${p.earned}/${p.max}</td></tr>`;
  }).join("");

  return `
    <div class="callout">
      <strong>¡Felicidades! Finalizaste todas las fases.</strong>
      <div class="small muted" style="margin-top:6px">
        Puntaje total: <strong>${earned}/${max}</strong> • Nota final: <strong>${grade10}/10</strong>
      </div>
    </div>

    <div class="section">
      <h3 style="margin:0 0 8px; font-size:15px">Resumen por fases</h3>
      <table class="table">
        <tr><th>Fase</th><th>Enfoque</th><th>Puntaje</th></tr>
        ${rows}
      </table>
