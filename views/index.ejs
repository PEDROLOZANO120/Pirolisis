/* Docente: decodificar */
document.getElementById("btnDecode").addEventListener("click", () => {
  const adminTyped = (document.getElementById("teacherAdminKeyInput").value||"").trim();
  if(TEACHER_ADMIN_KEY && adminTyped !== TEACHER_ADMIN_KEY){
    toast("Clave docente de acceso no coincide.");
    return;
  }

  const code = document.getElementById("resultCodeInput").value;
  const out = decodeResultCode(code);

  const box = document.getElementById("decodedBox");
  const status = document.getElementById("decodedStatus");
  const table = document.getElementById("decodedTable");

  if(!out.ok){
    box.style.display = "none";
    toast(out.msg);
    return;
  }

  box.style.display = "block";
  status.textContent = `${out.msg} ${out.valid ? "" : " (Aun así se muestran datos decodificados.)"}`;

  const p = out.payload;
  const rows = [];

  rows.push(row("Estudiante", safe(p.student)));
  rows.push(row("Fecha (ISO)", safe(p.dateISO)));
  rows.push(row("Puntaje total", `${safe(p.earnedPoints)}/${safe(p.maxPoints)}`));
  rows.push(row("Nota sobre 10", safe(p.gradeOver10)));

  // resumen por fases
  if(p.byPhase){
    rows.push(`<tr><th colspan="2">Resumen por fases</th></tr>`);
    for(const phId of Object.keys(p.byPhase)){
      const pp = p.byPhase[phId];
      rows.push(row(`Fase ${phId}`, `${safe(pp.earned)}/${safe(pp.max)}`));
    }
  }

  table.innerHTML = rows.join("");
});

document.getElementById("btnClearDecode").addEventListener("click", () => {
  document.getElementById("resultCodeInput").value = "";
  document.getElementById("decodedBox").style.display = "none";
});

/* =========================================================
   HELPERS: HTML seguro + TOAST
   ========================================================= */

function escapeHtml(str){
  return String(str||"")
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}
function safe(x){
  if(x === null || x === undefined) return "—";
  return String(x);
}
function row(a,b){
  return `<tr><td style="width:40%"><strong>${escapeHtml(a)}</strong></td><td>${escapeHtml(b)}</td></tr>`;
}

let toastTimer = null;
function toast(msg){
  const t = document.getElementById("toast");
  t.textContent = msg;
  t.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove("show"), 2600);
}

function openStudentModal(){
  document.getElementById("studentNameInput").value = state.studentName || "";
  studentModal.classList.add("show");
}

