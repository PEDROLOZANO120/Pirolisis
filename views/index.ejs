<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Pirólisis de Residuos Plásticos — Recurso Ambiental (Offline)</title>
  <style>
    :root{
      --bg:#0b1220;
      --panel:#101a2e;
      --panel2:#0f1a33;
      --text:#eaf0ff;
      --muted:#b9c6ff;
      --soft:#233257;
      --accent:#66e3c4;
      --accent2:#7aa6ff;
      --warn:#ffd37a;
      --ok:#7CFFB2;
      --shadow: 0 10px 30px rgba(0,0,0,.35);
      --radius:16px;
      --radius2:20px;
      --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      --sans: system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, Noto Sans, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      background: radial-gradient(1200px 700px at 20% 10%, #14264f 0%, rgba(20,38,79,0) 60%),
                  radial-gradient(900px 600px at 90% 20%, #1b3b4f 0%, rgba(27,59,79,0) 55%),
                  radial-gradient(800px 600px at 50% 100%, #1f2742 0%, rgba(31,39,66,0) 60%),
                  var(--bg);
      color:var(--text);
      font-family:var(--sans);
      line-height:1.5;
    }
    a{color:var(--accent2); text-decoration:none}
    a:hover{text-decoration:underline}
    .topbar{
      position:sticky; top:0; z-index:10;
      background: rgba(11,18,32,.88);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(255,255,255,.08);
    }
    .topbar-inner{
      max-width:1200px; margin:0 auto;
      padding:14px 16px;
      display:flex; align-items:center; justify-content:space-between; gap:12px;
    }
    .brand{
      display:flex; align-items:center; gap:12px;
    }
    .logo{
      width:40px; height:40px; border-radius:12px;
      background: linear-gradient(135deg, rgba(102,227,196,.95), rgba(122,166,255,.95));
      box-shadow: var(--shadow);
      display:grid; place-items:center;
      color:#0b1220; font-weight:900;
      letter-spacing:-.5px;
    }
    .brand h1{
      margin:0;
      font-size:16px;
      line-height:1.2;
    }
    .brand .sub{
      display:block;
      color:var(--muted);
      font-size:12px;
      margin-top:2px;
    }
    .top-actions{
      display:flex; align-items:center; gap:10px; flex-wrap:wrap;
    }
    .pill{
      border:1px solid rgba(255,255,255,.14);
      background: rgba(16,26,46,.55);
      padding:8px 10px;
      border-radius:999px;
      font-size:12px;
      color:var(--muted);
      display:flex; align-items:center; gap:8px;
    }
    .pill strong{color:var(--text)}
    .btn{
      cursor:pointer;
      border:1px solid rgba(255,255,255,.16);
      background: rgba(16,26,46,.75);
      color:var(--text);
      padding:10px 12px;
      border-radius:12px;
      font-weight:650;
      font-size:13px;
      transition: transform .05s ease, background .2s ease, border-color .2s ease;
      user-select:none;
    }
    .btn:hover{background: rgba(16,26,46,.95); border-color: rgba(255,255,255,.22)}
    .btn:active{transform: translateY(1px)}
    .btn.primary{
      border-color: rgba(102,227,196,.5);
      background: rgba(102,227,196,.12);
    }
    .btn.primary:hover{
      background: rgba(102,227,196,.18);
    }
    .btn.danger{
      border-color: rgba(255,122,122,.55);
      background: rgba(255,122,122,.10);
    }
    .layout{
      max-width:1200px;
      margin: 18px auto 24px;
      padding: 0 16px;
      display:grid;
      grid-template-columns: 320px 1fr;
      gap: 16px;
    }
    @media (max-width: 980px){
      .layout{grid-template-columns: 1fr}
    }
    .card{
      background: rgba(16,26,46,.78);
      border:1px solid rgba(255,255,255,.10);
      border-radius: var(--radius2);
      box-shadow: var(--shadow);
      overflow:hidden;
    }
    .card .card-h{
      padding: 14px 16px;
      border-bottom:1px solid rgba(255,255,255,.08);
      display:flex; align-items:center; justify-content:space-between; gap:10px;
      background: rgba(16,26,46,.65);
    }
    .card .card-h h2{
      margin:0;
      font-size: 14px;
      letter-spacing: .2px;
    }
    .card .card-b{padding: 14px 16px}
    .small{font-size:12px; color:var(--muted)}
    .muted{color:var(--muted)}
    .grid2{display:grid; grid-template-columns: 1fr 1fr; gap:12px}
    @media (max-width: 980px){
      .grid2{grid-template-columns: 1fr}
    }
    .nav{
      display:flex;
      flex-direction:column;
      gap:10px;
    }
    .phase-item{
      border:1px solid rgba(255,255,255,.10);
      background: rgba(15,26,51,.6);
      border-radius: 14px;
      padding: 12px 12px;
      display:flex;
      gap:10px;
      cursor:pointer;
      transition: border-color .2s ease, background .2s ease, transform .05s ease;
    }
    .phase-item:hover{
      background: rgba(15,26,51,.8);
      border-color: rgba(255,255,255,.18);
    }
    .phase-item:active{transform: translateY(1px)}
    .phase-dot{
      width:28px; height:28px; border-radius: 10px;
      display:grid; place-items:center;
      flex:0 0 auto;
      font-weight:900; font-size:12px;
      background: rgba(122,166,255,.14);
      border:1px solid rgba(122,166,255,.35);
      color: var(--text);
    }
    .phase-item.locked{
      opacity:.55;
      cursor:not-allowed;
      filter: grayscale(.1);
    }
    .phase-item.locked:hover{
      background: rgba(15,26,51,.6);
      border-color: rgba(255,255,255,.10);
    }
    .phase-title{
      font-weight:800;
      font-size:13px;
      margin:0;
    }
    .phase-sub{
      margin:4px 0 0;
      font-size:12px;
      color: var(--muted);
    }
    .badge{
      font-size:11px;
      padding: 3px 8px;
      border-radius: 999px;
      border:1px solid rgba(255,255,255,.14);
      background: rgba(0,0,0,.12);
      color: var(--muted);
      white-space:nowrap;
    }
    .badge.ok{
      border-color: rgba(124,255,178,.45);
      background: rgba(124,255,178,.10);
      color: #dfffea;
    }
    .badge.warn{
      border-color: rgba(255,211,122,.55);
      background: rgba(255,211,122,.10);
      color: #fff1d3;
    }
    .content h2{
      margin:0 0 6px;
      font-size: 18px;
      letter-spacing: .2px;
    }
    .content .lead{
      margin: 0 0 12px;
      color: var(--muted);
      font-size: 13px;
    }
    .callout{
      border:1px solid rgba(102,227,196,.25);
      background: rgba(102,227,196,.08);
      border-radius: 14px;
      padding: 12px 12px;
      margin: 12px 0;
    }
    .callout strong{color: #dffff5}
    .section{
      border-top: 1px solid rgba(255,255,255,.08);
      padding-top: 12px;
      margin-top: 12px;
    }
    .kpi{
      display:flex; gap:10px; flex-wrap:wrap;
      margin-top: 10px;
    }
    .kpi .pill{padding:7px 10px}
    .figure{
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.08);
      border-radius: 16px;
      padding: 10px;
      overflow:auto;
    }
    .qcard{
      border:1px solid rgba(255,255,255,.10);
      background: rgba(15,26,51,.55);
      border-radius: 16px;
      padding: 12px 12px;
      margin: 10px 0;
    }
    .qhead{
      display:flex; justify-content:space-between; gap:10px; align-items:flex-start;
    }
    .qhead h3{
      margin:0;
      font-size: 14px;
      letter-spacing:.2px;
    }
    .qmeta{color:var(--muted); font-size:12px}
    .options{margin-top: 10px; display:grid; gap:8px}
    .opt{
      display:flex; gap:10px; align-items:flex-start;
      padding: 10px 10px;
      border-radius: 12px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.07);
      cursor:pointer;
    }
    .opt:hover{border-color: rgba(255,255,255,.18)}
    .opt input{margin-top:3px}
    .qactions{
      display:flex; gap:10px; flex-wrap:wrap;
      margin-top: 10px;
      align-items:center;
    }
    .feedback{
      margin-top: 10px;
      padding: 10px 10px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.10);
      color: var(--text);
    }
    .feedback.ok{
      border-color: rgba(124,255,178,.35);
      background: rgba(124,255,178,.08);
    }
    .feedback.tip{
      border-color: rgba(255,211,122,.35);
      background: rgba(255,211,122,.08);
    }
    .hr{height:1px; background: rgba(255,255,255,.08); margin: 12px 0}
    .inline{
      display:flex; gap:10px; flex-wrap:wrap;
      align-items:center;
    }
    .input{
      width:100%;
      padding: 12px 12px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,.14);
      background: rgba(0,0,0,.18);
      color: var(--text);
      outline: none;
      font-size: 13px;
    }
    .input::placeholder{color: rgba(185,198,255,.65)}
    .mono{
      font-family: var(--mono);
      font-size: 12px;
      word-break: break-all;
      white-space: pre-wrap;
    }
    .modal{
      position: fixed;
      inset: 0;
      display:none;
      background: rgba(0,0,0,.55);
      backdrop-filter: blur(8px);
      z-index: 50;
      align-items:center;
      justify-content:center;
      padding: 16px;
    }
    .modal.show{display:flex}
    .modal-card{
      width: min(720px, 100%);
      border-radius: 22px;
      border: 1px solid rgba(255,255,255,.12);
      background: rgba(16,26,46,.96);
      box-shadow: var(--shadow);
      overflow:hidden;
    }
    .modal-card .m-h{
      padding: 16px 16px;
      border-bottom: 1px solid rgba(255,255,255,.08);
      display:flex; justify-content:space-between; gap:10px; align-items:center;
    }
    .modal-card .m-h h2{margin:0; font-size:16px}
    .modal-card .m-b{padding: 14px 16px}
    .note{
      padding: 10px 12px;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.10);
      color: var(--muted);
      font-size: 12px;
    }
    .footer-links{
      display:flex; gap:12px; flex-wrap:wrap;
      margin-top: 10px;
      font-size: 12px;
      color: var(--muted);
    }
    .table{
      width:100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    .table th, .table td{
      border-bottom: 1px solid rgba(255,255,255,.10);
      padding: 10px 8px;
      text-align:left;
      vertical-align: top;
    }
    .table th{color: var(--muted); font-weight:800}
    .toast{
      position: fixed;
      left: 50%;
      bottom: 18px;
      transform: translateX(-50%);
      z-index: 60;
      display:none;
      background: rgba(16,26,46,.96);
      border:1px solid rgba(255,255,255,.12);
      box-shadow: var(--shadow);
      border-radius: 999px;
      padding: 10px 14px;
      font-size: 13px;
      color: var(--text);
      max-width: min(900px, 92vw);
    }
    .toast.show{display:block}
  </style>
</head>
<body>

<!--
  RECURSO OFFLINE — PIRÓLISIS DE RESIDUOS PLÁSTICOS (ING. AMBIENTAL)
  - Edita claves aquí: TEACHER_KEYS (y TEACHER_ADMIN_KEY si deseas).
  - Todo el contenido principal funciona sin internet.
  - Enlaces externos al final de cada fase son opcionales.
-->

<div class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <div class="logo">π</div>
      <div>
        <h1>Pirólisis de Residuos Plásticos — Enfoque Ambiental</h1>
        <span class="sub">Valorización, impactos y sostenibilidad (sin diseño avanzado de reactores)</span>
      </div>
    </div>
    <div class="top-actions">
      <div class="pill"><span>Estudiante:</span> <strong id="studentNamePill">—</strong></div>
      <div class="pill"><span>Progreso:</span> <strong id="progressPill">0%</strong></div>
      <div class="pill"><span>Nota:</span> <strong id="gradePill">—/10</strong></div>
      <div class="pill"><span>Generado:</span> <strong><%= buildTime %></strong></div>
      <button class="btn" id="btnOpenStudent">Cambiar estudiante</button>
      <button class="btn" id="btnTeacherMode">Modo docente</button>
      <button class="btn danger" id="btnReset">Reiniciar</button>
    </div>
  </div>
</div>

<div class="layout">
  <!-- Navegación -->
  <div class="card">
    <div class="card-h">
      <h2>Fases del proceso</h2>
      <span class="badge" id="navHint">bloqueado por clave</span>
    </div>
    <div class="card-b">
      <div class="nav" id="phaseNav"></div>
      <div class="hr"></div>
      <div class="small">
        <strong>Regla de avance:</strong> al finalizar una fase (respondiendo sus preguntas),
        se solicita una <strong>clave del docente</strong> para desbloquear la siguiente.
        Las claves se editan en la variable <span class="mono">TEACHER_KEYS</span>.
      </div>
    </div>
  </div>

  <!-- Contenido -->
  <div class="card content">
    <div class="card-h">
      <h2 id="phaseHeader">Bienvenida</h2>
      <span class="badge warn" id="phaseStatus">Sin iniciar</span>
    </div>
    <div class="card-b" id="phaseContent">
      <!-- Se inyecta por JS -->
    </div>
  </div>
</div>

<!-- Modal: Estudiante -->
<div class="modal" id="studentModal">
  <div class="modal-card">
    <div class="m-h">
      <h2>Inicio del recurso</h2>
      <button class="btn" id="btnCloseStudentModal">Cerrar</button>
    </div>
    <div class="m-b">
      <div class="grid2">
        <div>
          <p class="lead" style="margin-top:0">
            Este recurso es para <strong>estudiantes universitarios de Ingeniería Ambiental</strong>.
            Te guiará por 6 fases del proceso de pirólisis de plásticos, con enfoque ambiental y de sostenibilidad.
          </p>

          <div class="callout">
            <strong>Importante:</strong> no se realizan cálculos de diseño de reactores.
            Se analiza el proceso como <em>tecnología ambiental de valorización</em>, incluyendo impactos, control y sostenibilidad.
          </div>

          <label class="small"><strong>Nombre y apellido (para tu código de resultados)</strong></label>
          <input class="input" id="studentNameInput" placeholder="Ej.: José Lozano" />

          <div class="inline" style="margin-top:10px">
            <button class="btn primary" id="btnStart">Iniciar / Cargar progreso</button>
            <button class="btn" id="btnNew">Iniciar como nuevo</button>
          </div>

          <div class="note" style="margin-top:12px">
            El progreso se guarda en este dispositivo (almacenamiento local del navegador).
            Si cambias de computador o navegador, inicia desde cero.
          </div>
        </div>

        <div>
          <div class="figure">
            <!-- Mini-diagrama general offline (SVG) -->
            <svg viewBox="0 0 680 360" width="100%" height="auto" role="img" aria-label="Diagrama general de pirólisis como tecnología ambiental">
              <defs>
                <linearGradient id="g1" x1="0" x2="1">
                  <stop offset="0" stop-color="#66e3c4" stop-opacity=".95"/>
                  <stop offset="1" stop-color="#7aa6ff" stop-opacity=".95"/>
                </linearGradient>
              </defs>

              <rect x="20" y="25" width="180" height="70" rx="14" fill="rgba(15,26,51,.7)" stroke="rgba(255,255,255,.18)"/>
              <text x="110" y="58" text-anchor="middle" fill="#eaf0ff" font-family="system-ui" font-size="15" font-weight="700">Residuos plásticos</text>
              <text x="110" y="78" text-anchor="middle" fill="#b9c6ff" font-family="system-ui" font-size="12">caracterizar y separar</text>

              <rect x="250" y="25" width="190" height="70" rx="14" fill="rgba(15,26,51,.7)" stroke="rgba(255,255,255,.18)"/>
              <text x="345" y="58" text-anchor="middle" fill="#eaf0ff" font-family="system-ui" font-size="15" font-weight="700">Preparación</text>
              <text x="345" y="78" text-anchor="middle" fill="#b9c6ff" font-family="system-ui" font-size="12">limpieza, trituración</text>

              <rect x="470" y="25" width="190" height="70" rx="14" fill="rgba(15,26,51,.7)" stroke="rgba(255,255,255,.18)"/>
              <text x="565" y="58" text-anchor="middle" fill="#eaf0ff" font-family="system-ui" font-size="15" font-weight="700">Pirólisis</text>
              <text x="565" y="78" text-anchor="middle" fill="#b9c6ff" font-family="system-ui" font-size="12">sin oxígeno</text>

              <path d="M200 60 H245" stroke="url(#g1)" stroke-width="4" />
              <path d="M440 60 H465" stroke="url(#g1)" stroke-width="4" />

              <rect x="110" y="160" width="210" height="75" rx="14" fill="rgba(15,26,51,.7)" stroke="rgba(255,255,255,.18)"/>
              <text x="215" y="192" text-anchor="middle" fill="#eaf0ff" font-family="system-ui" font-size="14" font-weight="700">Productos</text>
              <text x="215" y="214" text-anchor="middle" fill="#b9c6ff" font-family="system-ui" font-size="12">aceite • gas • sólidos</text>

              <rect x="360" y="160" width="300" height="75" rx="14" fill="rgba(15,26,51,.7)" stroke="rgba(255,255,255,.18)"/>
              <text x="510" y="192" text-anchor="middle" fill="#eaf0ff" font-family="system-ui" font-size="14" font-weight="700">Control ambiental</text>
              <text x="510" y="214" text-anchor="middle" fill="#b9c6ff" font-family="system-ui" font-size="12">emisiones • seguridad • residuos</text>

              <path d="M565 95 V130 C565 142 555 150 542 150 H225 C212 150 200 142 200 130 V120" stroke="url(#g1)" stroke-width="4" fill="none"/>
              <path d="M215 235 V265 H510 V235" stroke="url(#g1)" stroke-width="4" fill="none"/>

              <rect x="20" y="270" width="640" height="70" rx="16" fill="rgba(102,227,196,.08)" stroke="rgba(102,227,196,.25)"/>
              <text x="340" y="300" text-anchor="middle" fill="#dffff5" font-family="system-ui" font-size="14" font-weight="800">Evaluación ambiental y sostenibilidad</text>
              <text x="340" y="322" text-anchor="middle" fill="#b9c6ff" font-family="system-ui" font-size="12">comparación con vertido e incineración • economía circular • huella</text>
            </svg>
          </div>

          <div class="note" style="margin-top:12px">
            Consejo: lee cada fase y responde con criterio ambiental: impactos, prevención, control y sostenibilidad.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Docente -->
<div class="modal" id="teacherModal">
  <div class="modal-card">
    <div class="m-h">
      <h2>Modo docente — Decodificar resultados</h2>
      <button class="btn" id="btnCloseTeacher">Cerrar</button>
    </div>
    <div class="m-b">
      <div class="note">
        Pega aquí el <strong>código de resultados</strong> generado al finalizar.
        El sistema mostrará <strong>nombre</strong>, <strong>nota</strong> y un resumen por fases.
      </div>

      <div class="section">
        <label class="small"><strong>Clave docente (opcional para restringir acceso)</strong></label>
        <input class="input" id="teacherAdminKeyInput" placeholder="Ingresa la clave docente de acceso (si se configuró)" />
        <div class="small muted" style="margin-top:6px">
          Si no deseas restringir este modo, deja <span class="mono">TEACHER_ADMIN_KEY</span> vacío.
        </div>
      </div>

      <div class="section">
        <label class="small"><strong>Código de resultados</strong></label>
        <textarea class="input mono" id="resultCodeInput" rows="4" placeholder="Ej.: PYRO1|..."></textarea>
        <div class="inline" style="margin-top:10px">
          <button class="btn primary" id="btnDecode">Decodificar</button>
          <button class="btn" id="btnClearDecode">Limpiar</button>
        </div>
      </div>

      <div class="section" id="decodedBox" style="display:none">
        <div class="callout">
          <strong>Resultado decodificado</strong>
          <div class="small muted" id="decodedStatus" style="margin-top:6px"></div>
        </div>

        <table class="table" id="decodedTable"></table>
      </div>

      <div class="footer-links">
        <span class="muted">Sugerencia:</span>
        <span class="muted">pide al estudiante que envíe el código tal como aparece (sin espacios extra).</span>
      </div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* =========================================================
   CLAVES EDITABLES (DOCENTE)
   ========================================================= */

// Cada clave desbloquea la siguiente fase (tras finalizar la fase actual).
// Ejemplo: al terminar Fase 1, se pide TEACHER_KEYS[1] para abrir Fase 2.
const TEACHER_KEYS = {
  1: "P1-UTEQ-VERDE",
  2: "P2-UTEQ-LIMPIO",
  3: "P3-UTEQ-INERTE",
  4: "P4-UTEQ-PRODUCTOS",
  5: "P5-UTEQ-CONTROL"
  // Fase 6 es final (no necesita clave para otra fase)
};

// Si deseas restringir el “Modo docente”, define una clave aquí.
// Si lo dejas vacío "", el modo docente estará accesible sin clave.
const TEACHER_ADMIN_KEY = "";

// “Sal” simple para validar el código (no es seguridad criptográfica; es validación práctica offline).
// Puedes cambiarlo si deseas que los códigos no sean intercambiables entre versiones.
const TEACHER_SECRET = "CAMBIA-ESTE-SECRETO-2026";

/* =========================================================
   DATOS DEL CURSO (Fases + Contenido + Preguntas)
   ========================================================= */

const PHASES = [
  {
    id: 1,
    short: "Generación y caracterización",
