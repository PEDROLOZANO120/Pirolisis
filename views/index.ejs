function phaseUnlocked(phaseId){
  // 1 siempre desbloqueada si hay estudiante.
  if(phaseId === 1) return !!state.studentName;
  return !!state.phaseUnlocks[phaseId - 1]; // se desbloquea cuando se valida clave de fase anterior
}

function renderNav(){
  elNav.innerHTML = "";
  for(const ph of PHASES){
    const unlocked = phaseUnlocked(ph.id);
    const done = !!state.phaseFinished[ph.id];
    const item = document.createElement("div");
    item.className = "phase-item" + (unlocked ? "" : " locked");
    item.onclick = () => {
      if(!unlocked){
        toast("Esta fase está bloqueada. Finaliza la fase anterior y pide la clave docente.");
        return;
      }
      goToPhase(ph.id);
    };

    const dot = document.createElement("div");
    dot.className = "phase-dot";
    dot.textContent = ph.id;

    const box = document.createElement("div");
    box.style.flex = "1";

    const t = document.createElement("p");
    t.className = "phase-title";
    t.textContent = `Fase ${ph.id}`;

    const s = document.createElement("p");
    s.className = "phase-sub";
    s.textContent = ph.short;

    const badge = document.createElement("span");
    badge.className = "badge " + (done ? "ok" : "warn");
