const APP_VERSION = "PYRO_ENV_1.0";
let state = {
  version: APP_VERSION,
  studentName: "",
  unlockedPhase: 1,             // fase máxima desbloqueada
  currentPhase: 0,              // 0=bienvenida
  answers: {},                  // {qid:{choice, attempts, awarded}}
  phaseFinished: {},            // {phaseId:true}
  phaseUnlocks: {},             // {phaseId:true} (desbloqueo mediante clave)
};

function storageKey(name){
  return `pyro_env_${APP_VERSION}_${(name||"").trim().toLowerCase()}`;
}
function saveState(){
  if(!state.studentName) return;
  localStorage.setItem(storageKey(state.studentName), JSON.stringify(state));
  updateTopPills();
}
function loadState(name){
  const raw = localStorage.getItem(storageKey(name));
  if(!raw) return null;
  try { return JSON.parse(raw); } catch(e){ return null; }
}
function resetAll(){
  if(state.studentName){
    localStorage.removeItem(storageKey(state.studentName));
  }
  state = {
    version: APP_VERSION,
    studentName: state.studentName || "",
    unlockedPhase: 1,
    currentPhase: 0,
    answers: {},
    phaseFinished: {},
    phaseUnlocks: {},
  };
  saveState();
  renderNav();
  goToPhase(0);
  toast("Progreso reiniciado en este dispositivo.");
}

/* =========================================================
   UTILIDADES (preguntas, puntaje, base64, hash offline)
   ========================================================= */

function q(id, prompt, options, correctIndex, fbOk, fbTip){
  return { id, prompt, options, correctIndex, fbOk, fbTip };
}

function computeEarnedPoints(){
  // 1.0 si acierta en 1 intento; 0.5 si acierta en 2 intentos; 0 si no acierta.
  let earned = 0;
  let max = 0;
  for(const ph of PHASES){
    for(const qu of ph.questions){
      max += 1;
      const a = state.answers[qu.id];
      if(!a) continue;
      if(a.awarded === 1) earned += 1;
      else if(a.awarded === 0.5) earned += 0.5;
    }
  }
  return {earned, max};
}

function computeProgress(){
  // Progreso = preguntas respondidas / total preguntas.
  let total = 0, done = 0;
  for(const ph of PHASES){
    for(const qu of ph.questions){
      total++;
      if(state.answers[qu.id] && Number(state.answers[qu.id].attempts||0) > 0) done++;
    }
  }
  return total ? Math.round((done/total)*100) : 0;
}

function round1(x){ return Math.round(x*10)/10; }

function utf8ToB64(str){
  // Base64 robusta para tildes/ñ: encodeURIComponent -> escape -> btoa
  return btoa(unescape(encodeURIComponent(str)));
}
function b64ToUtf8(b64){
  return decodeURIComponent(escape(atob(b64)));
}
function fnv1a(str){
  // Hash simple offline (FNV-1a 32-bit) -> hex
  let h = 0x811c9dc5;
  for(let i=0;i<str.length;i++){
    h ^= str.charCodeAt(i);
    h = (h + ((h<<1) + (h<<4) + (h<<7) + (h<<8) + (h<<24))) >>> 0;
  }
  return ("00000000" + h.toString(16)).slice(-8);
}

function buildResultPayload(){
  const {earned, max} = computeEarnedPoints();
  const grade10 = max ? round1((earned/max)*10) : 0;

  // Resumen por fase
  const byPhase = {};
  for(const ph of PHASES){
    let e = 0, m = ph.questions.length;
    for(const qu of ph.questions){
      const a = state.answers[qu.id];
      if(!a) continue;
      if(a.awarded === 1) e += 1;
      else if(a.awarded === 0.5) e += 0.5;
    }
    byPhase[ph.id] = { earned: e, max: m };
  }

  return {
    app: APP_VERSION,
    student: state.studentName,
    dateISO: new Date().toISOString(),
    earnedPoints: earned,
    maxPoints: max,
    gradeOver10: grade10,
    byPhase
  };
}

function buildResultCode(){
  const payload = buildResultPayload();
  const json = JSON.stringify(payload);
  const dataB64 = utf8ToB64(json);
  const sig = fnv1a(json + "|" + TEACHER_SECRET);
  // Prefijo con versión y separador
  return `PYRO1|${dataB64}.${sig}`;
}

function decodeResultCode(code){
  const trimmed = (code||"").trim();
  if(!trimmed.startsWith("PYRO1|")) return { ok:false, msg:"Formato no reconocido (debe iniciar con PYRO1|)." };

  const body = trimmed.slice(6);
  const parts = body.split(".");
  if(parts.length !== 2) return { ok:false, msg:"Código incompleto: falta separador o firma." };

  const dataB64 = parts[0];
  const sig = parts[1];

  let json;
  try { json = b64ToUtf8(dataB64); }
  catch(e){ return { ok:false, msg:"No se pudo decodificar el bloque base64." }; }

  const expected = fnv1a(json + "|" + TEACHER_SECRET);
  const valid = (sig === expected);

  let payload;
  try { payload = JSON.parse(json); }
  catch(e){ return { ok:false, msg:"El contenido decodificado no es JSON válido." }; }

  return {
    ok:true,
    valid,
    msg: valid ? "Firma válida (código consistente con esta versión/clave)." : "Firma no coincide (posible versión distinta o secreto diferente).",
    payload
  };
}

