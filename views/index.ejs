function computePhasePoints(phaseId){
  const ph = PHASES.find(p => p.id === phaseId);
  let e = 0;
  for(const qu of ph.questions){
    const a = state.answers[qu.id];
    if(!a) continue;
    if(a.awarded === 1) e += 1;
    else if(a.awarded === 0.5) e += 0.5;
  }
  return { earned: e, max: ph.questions.length };
}

function goToPhase(phaseId){
  state.currentPhase = phaseId;
